// Cloudflare Workers: Tasks — статичный сайт из dist (сборка Vite); база и вход — в Supabase.
// _headers из dist применяется (кеш, CSP и другие заголовки безопасности).
// Адреса экранов — через # (index.html на «/»), поэтому на любой другой путь — честная 404 (dist/404.html), а не главная.
{
  "name": "task-boart-hsym",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
