// Cloudflare Workers: Tasks — статичный сайт из dist (сборка Vite); база и вход — в Supabase.
// _headers из dist применяется (кеш, CSP и другие заголовки безопасности).
// Адреса экранов — через # (index.html на «/»), поэтому на любой другой путь — честная 404 (dist/404.html), а не главная.
{
  "name": "task-boart-hsym",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  // Сайт — только на своём домене (домен в Spaceship, DNS в Cloudflare). Домен задан здесь: без него каждая выкатка
  // снова включала бы адрес *.workers.dev, а домен, добавленный только в панели, Wrangler мог бы снять.
  "routes": [{ "pattern": "taskmanager.cam", "custom_domain": true }],
  // старый адрес task-boart-hsym.norinnort4.workers.dev выключен; превью-ссылки версий (тест веток, например Update) — включены:
  // <ветка>-task-boart-hsym.<поддомен>.workers.dev; прод при этом только на taskmanager.cam
  "workers_dev": false,
  "preview_urls": true
}
