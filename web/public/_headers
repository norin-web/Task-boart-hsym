# Cloudflare Pages: заголовки ответа (на GitHub Pages файл просто лежит и ничего не делает)
# Сборка — с хешами в именах файлов: их можно кешировать навсегда; index.html — всегда свежий, чтобы обновления доходили сразу.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()
